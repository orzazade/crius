#!/bin/bash
# Install (or reinstall) the five Crius launchd jobs: the ingest every 10 min, the watchdog and the missed-wake watch
# (wakewatch) every 5 min, the goal report at 09:00 and 18:00, and the weekly job (scorecards and the restore test,
# Thursday 04:00). Builds the job binaries, crius-statusline (the statusLine command), crius-rec (for launchers:
# quota --room; the goal report) and bus-post (the bus writer) from this checkout into ~/.crius/bin with the run
# scripts, then prints each installed plist and the job state, so the owner sees exactly what was installed.
set -euo pipefail
repo="$(cd "$(dirname "$(realpath "$0")")/.." && pwd -P)"
bin="$HOME/.crius/bin"
# The paths go into sed replacements and XML; refuse anything that would need escaping in either.
for p in "$repo" "$HOME"; do
  case "$p" in *[!A-Za-z0-9._/-]*) echo "unsupported character in path: $p" >&2; exit 1 ;; esac
done
# The jobs run what is built here and read this checkout as CRIUS_REPO: only what was pushed, never work in progress.
# A stable checkout: git clone https://github.com/orzazade/crius ~/Projects/scifi/crius-live (git pull after a push).
# Each read is its own assignment: a git that fails stops here, never compares as an empty answer.
top="$(git -C "$repo" rev-parse --show-toplevel 2> /dev/null)" && [ "$top" = "$repo" ] ||
  { echo "$repo is not a git checkout; install from a clean checkout at origin/main" >&2; exit 1; }
changes="$(git -C "$repo" status --porcelain)"
if [ -n "$changes" ]; then
  echo "$repo has changes not pushed; install from a clean checkout at origin/main" >&2; exit 1
fi
head="$(git -C "$repo" rev-parse --verify HEAD)"
main="$(git -C "$repo" rev-parse --verify --quiet refs/remotes/origin/main)" ||
  { echo "$repo has no origin/main; git fetch, then install from a clean checkout at origin/main" >&2; exit 1; }
if [ "$head" != "$main" ]; then
  echo "$repo is not at origin/main (git pull first); install from a clean checkout at origin/main" >&2; exit 1
fi
[ -d "$HOME/.crius/state" ] || { echo "~/.crius is missing; run bin/crius-rec init first" >&2; exit 1; }
mkdir -p -m 700 "$bin"
for cmd in crius-ingest crius-watchdog crius-wakewatch crius-statusline crius-rec bus-post; do
  GOTOOLCHAIN=local go -C "$repo" build -o "$bin/$cmd" "./cmd/$cmd"
done
install -m 755 "$repo/bin/crius-digest-run" "$bin/crius-digest-run"
install -m 755 "$repo/bin/crius-weekly-run" "$bin/crius-weekly-run"
dest="$HOME/Library/LaunchAgents"
mkdir -p "$dest"
for job in ingest watchdog wakewatch digest weekly; do
  label="space.scifilab.crius.$job"
  plist="$dest/$label.plist"
  sed -e "s#@REPO@#$repo#g" -e "s#@HOME@#$HOME#g" "$repo/launchd/$label.plist.in" > "$plist.tmp"
  plutil -lint "$plist.tmp" > /dev/null
  mv "$plist.tmp" "$plist"
  launchctl bootout "gui/$(id -u)/$label" 2> /dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  echo "=== installed $plist"
  cat "$plist"
  launchctl print "gui/$(id -u)/$label" | /usr/bin/grep -E '^\s*(state|run interval|last exit code) ='
done
# health counts a restore test that never ran as a problem: the first install runs the weekly job once now.
if [ ! -f "$HOME/.crius/state/restore-test.json" ]; then
  launchctl kickstart "gui/$(id -u)/space.scifilab.crius.weekly"
  echo "=== started space.scifilab.crius.weekly once (no restore test result yet); log ~/.crius/logs/weekly.log"
fi
