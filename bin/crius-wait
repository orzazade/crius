#!/bin/bash
# Crius's one bus waiter (owner 10-30, "too much noise"): one team-wait over every bus log in place of one per project.
# It wakes Crius only for DONE, NEED and NEED-*, BLOCKED, S1, owner lines, the first answer to what Crius wrote and
# the watch channels (ALERT, ASK, CLEAR-READY, waits:*); every other line that would have woken it goes to the digest
# file the 09:00/18:00 report counts. --watch-dir reads every bus log, a log born while it waits from line 1. Arm it
# again after each wake, like any waiter. Extra arguments go to team-wait (e.g. --max-hours 12).
# The first run starts each log where the old crius-role cursors (~/.crius/wait-cursor-<p>) stopped, the furthest one
# of them, and every other bus log at its end; it joins their asks (who Crius waits on, the latest per sender). Other
# roles' cursors are not Crius's.
set -u
c=$HOME/.crius
cur=$c/wait-cursor-all
bus=$(cd "$c/bus" && pwd -P) || { echo "WAIT-ERROR no bus folder $c/bus"; exit 2; }
if [ ! -e "$cur" ]; then
  olds=()
  for f in "$c"/wait-cursor-*; do
    case $f in *.flock | *.holder | *.role | *.asks | *.lock | *.seen | *.tmp.* | "$cur") continue ;; esac
    [ -f "$f" ] && [ "$(cat "$f.role" 2>/dev/null)" = crius ] && olds+=("$f")
  done
  # every log is written down, at the furthest old cursor or at its end: a log this cursor does not name is then read
  # from line 1 (one born later), also when there was no old cursor
  for l in "$bus"/*.log; do [ -f "$l" ] && printf 'END\t%s\t%s\n' "$(wc -l < "$l" | tr -d ' ')" "$l"; done |
    awk -F'\t' '$1 == "END" && NF == 3 { e[$3] = $2 + 0; next }
      NF == 2 && $1 ~ /^[0-9]+$/ && ($2 in e) { if (!($2 in m) || $1 + 0 > m[$2]) m[$2] = $1 + 0 }
      END { for (p in e) print ((p in m) ? m[p] : e[p]) "\t" p }' - ${olds[@]+"${olds[@]}"} > "$cur.tmp" || exit 4
  asks=()
  for f in ${olds[@]+"${olds[@]}"}; do [ -f "$f.asks" ] && asks+=("$f.asks"); done
  if [ ${#asks[@]} -gt 0 ]; then
    awk -F'\t' 'NF == 2 { if (!($1 in m) || $2 + 0 > m[$1]) m[$1] = $2 + 0 } END { for (s in m) print s "\t" m[s] }' \
      "${asks[@]}" > "$cur.asks" || exit 4
  fi
  mv "$cur.tmp" "$cur" || exit 4
fi
exec bash "$HOME/.claude/skills/cmux-team/scripts/team-wait.sh" --mode crius --role crius --alias crius:lead \
  --digest "$c/state/crius/bus-digest.log" --cursor "$cur" --watch-dir "$bus" "$@"
