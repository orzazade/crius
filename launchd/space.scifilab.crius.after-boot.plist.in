<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>space.scifilab.crius.after-boot</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.crius/bin/crius-wakewatch</string>
		<string>after-boot</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>PATH</key>
		<string>/Applications/cmux.app/Contents/Resources/bin:/usr/bin:/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@HOME@/.crius/logs/after-boot.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/.crius/logs/after-boot.log</string>
</dict>
</plist>
