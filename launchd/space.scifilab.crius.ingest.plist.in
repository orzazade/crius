<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>space.scifilab.crius.ingest</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.crius/bin/crius-ingest</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin</string>
		<key>CRIUS_REPO</key>
		<string>@REPO@</string>
	</dict>
	<key>StartInterval</key>
	<integer>600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@HOME@/.crius/logs/ingest.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/.crius/logs/ingest.log</string>
</dict>
</plist>
